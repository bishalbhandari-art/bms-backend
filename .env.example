# Root database configuration for local development
DB_HOST=localhost
DB_PORT=5433
DB_NAME=bms_database
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-local-password
DB_LOGGING=false

# Docker Compose credentials
POSTGRES_DB=bms_database
POSTGRES_USER=postgres
RABBITMQ_USER=bms_user
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
